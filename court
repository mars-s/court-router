#!/bin/zsh
set -euo pipefail

ROOT="${0:A:h}"
COURT_STATE_DIR="${COURT_STATE_DIR:-$HOME/.local/state/court}"
COURT_PORT="${COURT_PORT:-8477}"
PIDFILE="$COURT_STATE_DIR/court.pid"
LOGFILE="$COURT_STATE_DIR/court.log"
URL="http://127.0.0.1:$COURT_PORT"

mkdir -p "$COURT_STATE_DIR"

running() {
  [[ -f "$PIDFILE" ]] && kill -0 "$(<"$PIDFILE")" 2>/dev/null
}

case "${1:-help}" in
  up)
    if running; then echo "Court is already running at $URL"; exit 0; fi
    rm -f "$PIDFILE"
    COURT_STATE_DIR="$COURT_STATE_DIR" COURT_PORT="$COURT_PORT" /usr/bin/env node "$ROOT/server.mjs" --daemon > "$PIDFILE" 2>> "$LOGFILE"
    sleep 1
    if running; then echo "Court is up at $URL"; else echo "Court failed to start; see $LOGFILE"; exit 1; fi
    ;;
  down)
    if running; then kill "$(<"$PIDFILE")"; rm -f "$PIDFILE"; echo "Court is down"; else rm -f "$PIDFILE"; echo "Court is not running"; fi
    # In Court mode every ChatGPT chat goes through Court, GPT included.
    if grep -qF "openai_base_url = \"$URL/chatgpt\"" "${COURT_CODEX_CONFIG:-$HOME/.codex/config.toml}" 2>/dev/null; then
      echo "Warning: Court mode is still on, so ChatGPT chats will fail until Court is back up." >&2
      echo "To use ChatGPT without Court, start Court and choose Restore ChatGPT first." >&2
    fi
    ;;
  status)
    if running; then echo "Court is up at $URL"; else echo "Court is down"; fi
    ;;
  open)
    open "$URL"
    ;;
  connect)
    case "${2:-}" in
      codex) exec CLIProxyAPI --codex-login ;;
      claude) exec CLIProxyAPI --claude-login ;;
      antigravity) exec CLIProxyAPI --antigravity-login ;;
      gemini) exec gemini ;;
      grok) exec CLIProxyAPI --xai-login ;;
      kimi) exec CLIProxyAPI --kimi-login ;;
      *) echo "Usage: court connect {codex|claude|antigravity|gemini|grok|kimi}"; exit 2 ;;
    esac
    ;;
  claude)
    # The Claude workflow: the Claude desktop app in gateway mode, on the same Router.
    CLAUDE_LABEL="com.court.claude-websearch-relay"
    CLAUDE_PLIST="$HOME/Library/LaunchAgents/$CLAUDE_LABEL.plist"
    case "${2:-}" in
      config) exec /usr/bin/env node "$ROOT/claude/config.mjs" ;;
      relay)
        case "${3:-run}" in
          run) exec /usr/bin/env node "$ROOT/claude/websearch-relay.mjs" ;;
          install)
            NODE="$(command -v node)"
            mkdir -p "$HOME/Library/LaunchAgents"
            cat > "$CLAUDE_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>$CLAUDE_LABEL</string>
<key>ProgramArguments</key><array><string>$NODE</string><string>$ROOT/claude/websearch-relay.mjs</string></array>
<key>EnvironmentVariables</key><dict><key>COURT_STATE_DIR</key><string>$COURT_STATE_DIR</string></dict>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardErrorPath</key><string>$COURT_STATE_DIR/claude-relay.log</string>
</dict></plist>
PLIST
            launchctl bootout "gui/$(id -u)/$CLAUDE_LABEL" 2>/dev/null || true
            launchctl bootstrap "gui/$(id -u)" "$CLAUDE_PLIST"
            echo "Web search relay installed; it starts at login. Log: $COURT_STATE_DIR/claude-relay.log"
            ;;
          uninstall)
            launchctl bootout "gui/$(id -u)/$CLAUDE_LABEL" 2>/dev/null || true
            rm -f "$CLAUDE_PLIST"
            echo "Web search relay removed"
            ;;
          *) echo "Usage: court claude relay {run|install|uninstall}"; exit 2 ;;
        esac
        ;;
      app)
        APP="/Applications/Claude (Gateway).app"
        DATA="$HOME/Library/Application Support/Claude-Gateway"
        osacompile -o "$APP" -e "do shell script \"open -n -a \\\"/Applications/Claude.app\\\" --args --user-data-dir=\\\"$DATA\\\" > /dev/null 2>&1 &\""
        cp /Applications/Claude.app/Contents/Resources/electron.icns "$APP/Contents/Resources/applet.icns"
        touch "$APP"
        echo "Created $APP. Run 'court claude config' before opening it."
        ;;
      status)
        if launchctl print "gui/$(id -u)/$CLAUDE_LABEL" >/dev/null 2>&1; then echo "Web search relay: running"; else echo "Web search relay: not installed"; fi
        [[ -d "/Applications/Claude (Gateway).app" ]] && echo "Claude (Gateway) app: installed" || echo "Claude (Gateway) app: not installed"
        [[ -f "$COURT_STATE_DIR/claude.json" ]] && echo "Settings: $COURT_STATE_DIR/claude.json" || echo "Settings: defaults (no $COURT_STATE_DIR/claude.json)"
        ;;
      *) echo "Usage: court claude {config|relay [run|install|uninstall]|app|status}"; exit 2 ;;
    esac
    ;;
  *)
    echo "Court, a local Router account dashboard"
    echo "Usage: court {up|down|status|open|connect <codex|claude|antigravity|gemini|grok|kimi>|claude <config|relay|app|status>}"
    ;;
esac
